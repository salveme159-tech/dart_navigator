# OpenDART: optional server-side fallback. The dashboard can also use a key entered in the browser.
OPENDART_API_KEY=발급받은_OpenDART_인증키

# Optional market-data API keys used only if the corresponding server endpoints are enabled.
ECOS_API_KEY=발급받은_ECOS_인증키
EXIM_EXCHANGE_API_KEY=발급받은_환율_API_인증키

# Persistent connection encryption secret. Generate randomly once; keep unchanged across redeploys.
# No AGENT_API_KEY is needed for GPT Actions. Do not commit the actual value.
AGENT_CONNECTION_SECRET=

# Optional durable per-code revocation store (HTTPS REST, not redis://).
AGENT_REVOCATION_REDIS_URL=
AGENT_REVOCATION_REDIS_TOKEN=
# Alternative for ONE server with a persistent mounted disk; not free Render ephemeral storage.
AGENT_REVOCATION_FILE=
# Process-local DART request budget per key per Korea calendar day.
DART_DAILY_REQUEST_BUDGET=18000
